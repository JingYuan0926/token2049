{
  "name": "aiken-auditor",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit": "node --env-file-if-exists=.env src/cli/audit.mjs",
    "worker": "node --env-file-if-exists=.env --env-file-if-exists=.local/mps-runtime.env src/worker.mjs",
    "review": "node --env-file-if-exists=.env src/cli/review.mjs",
    "test": "node --env-file-if-exists=.env --test 'test/*.test.mjs'",
    "eval": "node --env-file-if-exists=.env src/cli/eval.mjs",
    "x402": "node --env-file-if-exists=.env --env-file-if-exists=.local/mps-runtime.env src/x402/server.mjs",
    "buy": "node --env-file-if-exists=.env src/cli/buy.mjs"
  },
  "dependencies": {
    "@evolution-sdk/evolution": "0.5.17",
    "@x402/cardano": "2.28.0",
    "@x402/core": "2.28.0",
    "openai": "^7.30.0",
    "zod": "^4.6.5"
  }
}
